# These settings are ONLY used by the optional future backend profile:
# docker compose up -d --build
# The browser-only free edition uses none of these values.
# NEVER place a secret in VITE_* variables; they ship to every browser.
POSTGRES_USER=map
POSTGRES_PASSWORD=local_development_only
POSTGRES_DB=research_map
OPENALEX_API_KEY=
OPENALEX_EMAIL=
CACHE_TTL_HOURS=24
GUEST_DAILY_SEARCH_LIMIT=20
USAGE_HASH_SALT=
EMBEDDING_PROVIDER=tfidf
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=nomic-embed-text
